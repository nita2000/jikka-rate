---
import "../styles/global.css";
import siteMeta from "../data/meta.json";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  showPrNotice?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description,
  canonicalPath = "/",
  schema,
} = Astro.props;

const siteName = "実家と空き家の試算表";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const baseOrigin = Astro.site ?? "https://jikka-shisan.com";
const canonicalUrl = new URL(canonicalPath, baseOrigin).toString();
const ogImageUrl = new URL("/og-image.png", baseOrigin).toString();

const navItems = [
  { href: "/tools/disposal-simulator/", label: "実家処分試算" },
  { href: "/tools/akiya-tax/", label: "空き家の税金" },
  { href: "/tools/inheritance-deadline/", label: "相続期限" },
  { href: "/tools/hakajimai-simulator/", label: "墓じまい試算" },
  { href: "/cases/", label: "タイプ別相場" },
  { href: "/compare/", label: "2択比較" },
  { href: "/pref/", label: "47都道府県" },
  { href: "/guide/", label: "解説ガイド" },
];

const currentPath = Astro.url.pathname;
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || "";
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION?.trim() || "";
const hasHero = Astro.slots.has("hero");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#047857" />
    <link rel="alternate" type="application/rss+xml" title="実家と空き家の試算表 売却・空き家税・解体・墓じまいガイド" href="/rss.xml" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    {
      gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
    {
      schemas.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- 1段固定ヘッダー（丸に実家屋根＋レート折れ線紋） -->
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur-sm">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex h-16 items-center justify-between gap-3">
          <a href="/" class="flex items-center gap-2.5 shrink-0 group">
            <svg class="h-9 w-9 shrink-0" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <circle cx="32" cy="32" r="30" fill="#047857" class="group-hover:fill-[#065F46] transition-colors"/>
              <path d="M32 13.5 L12.5 29.2 H18.2 V47.5 C18.2 48.6 19.1 49.5 20.2 49.5 H43.8 C44.9 49.5 45.8 48.6 45.8 47.5 V29.2 H51.5 L32 13.5 Z" fill="#FFFFFF"/>
              <rect x="22" y="27.5" width="20" height="14.5" rx="1.8" fill="#047857" class="group-hover:fill-[#065F46] transition-colors"/>
              <path d="M24.8 38.2 L29.5 33.8 L33.2 36.2 L39.2 30.5" stroke="#FFFFFF" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"/>
              <rect x="29.5" y="44" width="5" height="5.5" fill="#047857" class="group-hover:fill-[#065F46] transition-colors"/>
            </svg>
            <div class="leading-tight whitespace-nowrap">
              <div class="text-base sm:text-[17px] font-extrabold text-slate-900 tracking-tight group-hover:text-emerald-700 transition-colors">
                実家と空き家の試算表
              </div>
              <div class="text-[11px] font-medium text-slate-500 hidden 2xl:block">
                売却手残り・解体費・空き家税・相続期限・墓じまい試算
              </div>
            </div>
          </a>

          <!-- 下線インジケーター型の凛としたナビ（1024px幅でも衝突しない設計） -->
          <nav class="hidden lg:flex items-center gap-0.5 shrink-0" aria-label="メインナビゲーション">
            {
              navItems.map((item) => {
                const isActive =
                  item.href === "/"
                    ? currentPath === "/"
                    : currentPath.startsWith(item.href);
                return (
                  <a
                    href={item.href}
                    class:list={[
                      "relative px-2 xl:px-2.5 py-2 text-xs xl:text-[13px] font-bold whitespace-nowrap transition-colors",
                      isActive
                        ? "text-emerald-700"
                        : "text-slate-600 hover:text-slate-900",
                    ]}
                  >
                    {item.label}
                    {isActive && (
                      <span class="absolute bottom-0 left-2 right-2 h-0.5 bg-emerald-700" />
                    )}
                  </a>
                );
              })
            }
          </nav>

          <!-- モバイル開閉ボタン -->
          <button
            type="button"
            id="mobile-menu-btn"
            class="lg:hidden inline-flex items-center gap-1.5 rounded-xs border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-slate-50"
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <svg class="h-4 w-4 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <span id="mobile-menu-label">メニュー</span>
          </button>
        </div>

        <nav id="mobile-nav" class="hidden lg:hidden pb-4 border-t border-slate-100 pt-3" aria-label="モバイルナビゲーション">
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
            <a
              href="/"
              class:list={[
                "rounded-xs border px-3 py-2 text-xs font-bold transition-colors",
                currentPath === "/"
                  ? "border-emerald-700 bg-emerald-700 text-white"
                  : "border-slate-200 bg-slate-50 text-slate-700 hover:bg-white hover:text-emerald-700",
              ]}
            >
              トップ
            </a>
            {
              navItems.map((item) => {
                const isActive = currentPath.startsWith(item.href);
                return (
                  <a
                    href={item.href}
                    class:list={[
                      "rounded-xs border px-3 py-2 text-xs font-bold transition-colors",
                      isActive
                        ? "border-emerald-700 bg-emerald-700 text-white"
                        : "border-slate-200 bg-slate-50 text-slate-700 hover:bg-white hover:text-emerald-700",
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })
            }
          </div>
        </nav>
      </div>
    </header>

    {hasHero && <slot name="hero" />}

    <main class:list={["flex-1 mx-auto w-full max-w-6xl px-4 sm:px-6", hasHero ? "pt-9 pb-6 sm:pt-10 sm:pb-7" : "pt-7 pb-6 sm:pt-9 sm:pb-7"]}>
      <slot />
    </main>

    <!-- フッター -->
    <footer class="bg-white text-slate-600 mt-6 border-t border-slate-200">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-8 border-b border-slate-100">
          <div class="md:col-span-4 space-y-3">
            <div class="flex items-center gap-2.5">
              <svg class="h-7 w-7 shrink-0" viewBox="0 0 64 64" fill="none" aria-hidden="true">
                <circle cx="32" cy="32" r="30" fill="#047857"/>
                <path d="M32 13.5 L12.5 29.2 H18.2 V47.5 C18.2 48.6 19.1 49.5 20.2 49.5 H43.8 C44.9 49.5 45.8 48.6 45.8 47.5 V29.2 H51.5 L32 13.5 Z" fill="#FFFFFF"/>
                <rect x="22" y="27.5" width="20" height="14.5" rx="1.8" fill="#047857"/>
                <path d="M24.8 38.2 L29.5 33.8 L33.2 36.2 L39.2 30.5" stroke="#FFFFFF" stroke-width="2.7" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="29.5" y="44" width="5" height="5.5" fill="#047857"/>
              </svg>
              <span class="text-base font-extrabold text-slate-900 tracking-tight">実家と空き家の試算表</span>
            </div>
            <p class="text-xs leading-relaxed text-slate-500">
              総務省・国土交通省・厚生労働省の公的統計と最新税制にもとづき、実家の売却手残り・空き家の固定資産税・相続期限・墓じまいを試算・比較できるサイトです。
            </p>
            <div class="flex flex-wrap gap-1.5 pt-1 text-[11px]">
              <span class="rounded-xs bg-slate-50 border border-slate-200 px-2 py-0.5 text-slate-600">総務省 住宅・土地統計調査</span>
              <span class="rounded-xs bg-slate-50 border border-slate-200 px-2 py-0.5 text-slate-600">国交省 地価・除却基準</span>
              <span class="rounded-xs bg-slate-50 border border-slate-200 px-2 py-0.5 text-slate-600">3,000万円控除・相続登記対応</span>
            </div>
          </div>

          <div class="md:col-span-4">
            <div class="text-[11px] font-bold tracking-wide text-emerald-700 mb-3">試算シミュレーター・比較</div>
            <ul class="space-y-2 text-xs text-slate-600">
              <li><a href="/tools/disposal-simulator/" class="hover:text-emerald-700 transition-colors">実家の手残り試算（維持・解体・買取）</a></li>
              <li><a href="/tools/akiya-tax/" class="hover:text-emerald-700 transition-colors">空き家の固定資産税・相続登記試算</a></li>
              <li><a href="/tools/inheritance-deadline/" class="hover:text-emerald-700 transition-colors">相続期限・3,000万円控除カレンダー</a></li>
              <li><a href="/tools/hakajimai-simulator/" class="hover:text-emerald-700 transition-colors">墓じまい・永代供養 15年試算</a></li>
              <li><a href="/cases/" class="hover:text-emerald-700 transition-colors">実家・お墓のタイプ別相場一覧</a></li>
              <li><a href="/compare/" class="hover:text-emerald-700 transition-colors">よくある2択の損益比較</a></li>
            </ul>
          </div>

          <div class="md:col-span-4">
            <div class="text-[11px] font-bold tracking-wide text-emerald-700 mb-3">都道府県データ・サイト情報</div>
            <ul class="space-y-2 text-xs text-slate-600">
              <li><a href="/pref/" class="hover:text-emerald-700 transition-colors">全国47都道府県別の解体・土地相場</a></li>
              <li><a href="/history/" class="hover:text-emerald-700 transition-colors">年別の解体単価・維持費推移</a></li>
              <li><a href="/guide/" class="hover:text-emerald-700 transition-colors">実家・空き家の解説ガイド</a></li>
              <li><a href="/about/" class="hover:text-emerald-700 transition-colors">サイトについて・算出基準・公的出典</a></li>
              <li><a href="/privacy/" class="hover:text-emerald-700 transition-colors">プライバシーポリシー・免責・運営者情報</a></li>
            </ul>
          </div>
        </div>
        <div class="pt-5 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-500">
          <span>© {new Date().getFullYear()} 実家と空き家の試算表</span>
          <span class="tabular-nums">統計出典：{siteMeta.source_credit}</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById("mobile-menu-btn");
      const nav = document.getElementById("mobile-nav");
      const label = document.getElementById("mobile-menu-label");
      if (btn && nav) {
        btn.addEventListener("click", () => {
          const open = nav.classList.toggle("hidden") === false;
          btn.setAttribute("aria-expanded", String(open));
          if (label) label.textContent = open ? "閉じる" : "メニュー";
        });
      }

      document.addEventListener("click", (e) => {
        const link = e.target.closest && e.target.closest("[data-affiliate-slot]");
        if (link && typeof window.gtag === "function") {
          window.gtag("event", "affiliate_click", {
            affiliate_slot: link.getAttribute("data-affiliate-slot") || "",
            affiliate_label: link.getAttribute("data-affiliate-label") || "",
            page_path: window.location.pathname,
          });
        }
      });
    </script>
  </body>
</html>
