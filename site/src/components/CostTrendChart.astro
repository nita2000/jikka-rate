---
interface Point {
  date: string;
  wood_man_per_tsubo: number;
  steel_man_per_tsubo: number;
  rc_man_per_tsubo: number;
  repair_index?: number;
}

interface Props {
  series: Point[];
  title?: string;
  subtitle?: string;
}

const {
  series,
  title = "構造別 解体工事坪単価の推移（万円/坪）",
  subtitle,
} = Astro.props;

const width = 760;
const height = 256;
const padLeft = 52;
const padRight = 58;
const padTop = 26;
const padBottom = 30;
const plotW = width - padLeft - padRight;
const plotH = height - padTop - padBottom;

const allValues = series.flatMap((p) => [
  p.wood_man_per_tsubo,
  p.steel_man_per_tsubo,
  p.rc_man_per_tsubo,
]);
const minVal = Math.max(2.0, Math.floor((Math.min(...allValues) - 0.4) * 2) / 2);
const maxVal = Math.ceil((Math.max(...allValues) + 0.4) * 2) / 2;
const range = Math.max(2.0, maxVal - minVal);

const xAt = (idx: number) =>
  series.length <= 1 ? padLeft : padLeft + (idx / (series.length - 1)) * plotW;
const yAt = (val: number) => padTop + plotH - ((val - minVal) / range) * plotH;

const makePath = (getter: (p: Point) => number) =>
  series
    .map((p, i) => `${i === 0 ? "M" : "L"}${xAt(i).toFixed(1)},${yAt(getter(p)).toFixed(1)}`)
    .join(" ");

const pathRc = makePath((p) => p.rc_man_per_tsubo);
const pathSteel = makePath((p) => p.steel_man_per_tsubo);
const pathWood = makePath((p) => p.wood_man_per_tsubo);

const areaWood =
  series.length > 1
    ? `${pathWood} L${xAt(series.length - 1).toFixed(1)},${(padTop + plotH).toFixed(1)} L${xAt(0).toFixed(1)},${(padTop + plotH).toFixed(1)} Z`
    : "";

const yTicks = [0, 0.25, 0.5, 0.75, 1].map((t) => {
  const val = minVal + range * t;
  return { val: val.toFixed(1), y: yAt(val) };
});

const labelIndices =
  series.length >= 4
    ? [0, Math.floor(series.length / 3), Math.floor((series.length * 2) / 3), series.length - 1]
    : series.map((_, i) => i);

const lastIdx = series.length - 1;
const lastPoint = series[lastIdx];

const reformIdx = series.findIndex((p) => p.date >= "2024-04-01");
const showReformLine = reformIdx > 0 && reformIdx < series.length - 1;
const gradId = `wood-grad-${Math.abs(title.length * 31 + series.length)}`;
---

<div class="card-surface rounded p-5 sm:p-6">
  <div class="flex flex-wrap items-start justify-between gap-3 mb-4 pb-3 border-b border-slate-100">
    <div>
      <h3 class="text-sm sm:text-[15px] font-extrabold text-slate-900">{title}</h3>
      {subtitle && <p class="text-[11px] text-slate-500 mt-0.5">{subtitle}</p>}
    </div>
    <div class="flex items-center gap-4 text-[11px] font-bold">
      <span class="flex items-center gap-1.5 text-slate-600">
        <span class="inline-block w-3.5 h-0.5 border-t-2 border-dashed border-amber-600"></span>RC造
      </span>
      <span class="flex items-center gap-1.5 text-slate-600">
        <span class="inline-block w-3.5 h-0.5 bg-slate-500"></span>鉄骨造
      </span>
      <span class="flex items-center gap-1.5 text-emerald-800">
        <span class="inline-block w-3.5 h-1 bg-emerald-700 rounded-xs"></span>木造
      </span>
    </div>
  </div>

  <div class="w-full overflow-x-auto">
    <svg viewBox={`0 0 ${width} ${height}`} class="w-full h-auto min-w-[480px]" role="img" aria-label={title}>
      <defs>
        <linearGradient id={gradId} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#047857" stop-opacity="0.14" />
          <stop offset="100%" stop-color="#047857" stop-opacity="0.01" />
        </linearGradient>
      </defs>

      {
        yTicks.map((tick) => (
          <g>
            <line x1={padLeft} y1={tick.y} x2={width - padRight} y2={tick.y} stroke="#eef2f6" stroke-width="1" />
            <text x={padLeft - 8} y={tick.y + 3.5} text-anchor="end" fill="#64748b" font-size="10" class="tabular-nums">
              {tick.val}万
            </text>
          </g>
        ))
      }

      {
        showReformLine && (
          <g>
            <line
              x1={xAt(reformIdx)}
              y1={padTop}
              x2={xAt(reformIdx)}
              y2={padTop + plotH}
              stroke="#94a3b8"
              stroke-width="1"
              stroke-dasharray="3 3"
            />
            <text
              x={xAt(reformIdx) + 4}
              y={padTop - 7}
              text-anchor="start"
              fill="#64748b"
              font-size="9.5"
              font-weight="700"
            >
              2024年4月 相続登記義務化・建設2024年問題
            </text>
          </g>
        )
      }

      {areaWood && <path d={areaWood} fill={`url(#${gradId})`} />}
      <path d={pathRc} fill="none" stroke="#d97706" stroke-width="1.6" stroke-dasharray="4 3" />
      <path d={pathSteel} fill="none" stroke="#64748b" stroke-width="1.9" />
      <path d={pathWood} fill="none" stroke="#047857" stroke-width="2.6" stroke-linejoin="round" />

      {
        lastPoint && (
          <g>
            <circle cx={xAt(lastIdx)} cy={yAt(lastPoint.rc_man_per_tsubo)} r="3" fill="#ffffff" stroke="#d97706" stroke-width="1.8" />
            <circle cx={xAt(lastIdx)} cy={yAt(lastPoint.steel_man_per_tsubo)} r="3" fill="#ffffff" stroke="#64748b" stroke-width="1.8" />
            <circle cx={xAt(lastIdx)} cy={yAt(lastPoint.wood_man_per_tsubo)} r="4" fill="#ffffff" stroke="#047857" stroke-width="2.5" />
            <text x={xAt(lastIdx) + 7} y={yAt(lastPoint.rc_man_per_tsubo) + 3.5} fill="#b45309" font-size="10" font-weight="700" class="tabular-nums">
              {lastPoint.rc_man_per_tsubo.toFixed(2)}万
            </text>
            <text x={xAt(lastIdx) + 7} y={yAt(lastPoint.steel_man_per_tsubo) + 3.5} fill="#475569" font-size="10" font-weight="700" class="tabular-nums">
              {lastPoint.steel_man_per_tsubo.toFixed(2)}万
            </text>
            <text x={xAt(lastIdx) + 7} y={yAt(lastPoint.wood_man_per_tsubo) + 3.5} fill="#047857" font-size="10.5" font-weight="800" class="tabular-nums">
              {lastPoint.wood_man_per_tsubo.toFixed(2)}万
            </text>
          </g>
        )
      }

      {
        labelIndices.map((idx) => {
          const item = series[idx];
          if (!item) return null;
          return (
            <text
              x={xAt(idx)}
              y={height - 8}
              text-anchor={idx === 0 ? "start" : idx === series.length - 1 ? "end" : "middle"}
              fill="#64748b"
              font-size="10"
              class="tabular-nums"
            >
              {item.date.slice(0, 7)}
            </text>
          );
        })
      }
    </svg>
  </div>
</div>
