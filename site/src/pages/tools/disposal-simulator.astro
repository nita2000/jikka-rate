  <!-- スマホ専用：下部固定ミニ結果バー（入力中もリアルタイム試算額を常時表示） -->
  <div
    id="disp-mobile-bar"
    class="fixed bottom-0 inset-x-0 z-30 border-t border-slate-200 bg-white/95 backdrop-blur-sm px-4 py-2.5 shadow-lg transition-all duration-200 lg:hidden no-print"
  >
    <div class="mx-auto max-w-6xl flex items-center justify-between gap-3">
      <div class="min-w-0">
        <div id="disp-mob-label" class="text-[10px] font-bold text-slate-500 truncate">最有力ルートの試算目安</div>
        <div id="disp-mob-value" class="font-display text-base font-extrabold text-emerald-800 tabular-nums truncate">—</div>
      </div>
      <a
        href="#disp-result-panel"
        class="shrink-0 rounded-xs bg-emerald-700 hover:bg-emerald-800 text-white px-3.5 py-2 text-xs font-bold transition-colors whitespace-nowrap"
      >
        結果を見る ↓
      </a>
    </div>
  </div>

  <script
    is:inline
    define:vars={{
      presetsData: quickPresets,
      casesData: houseCases,
      prefsData: prefectures,
      taxRulesData: taxRules,
    }}
  >
    const allCases = [...presetsData, ...casesData];
    const byCase = Object.fromEntries(allCases.map((c) => [c.slug, c]));
    const byPref = Object.fromEntries(prefsData.map((p) => [p.slug, p]));

    const state = {
      spanYears: 10,
      ageGroup: "old45", // old45 | mid35 | new25
      loc: "suburb", // urban | suburb | rural | wakeari
      cond: "normal", // clean | normal | damaged
      taxExempt: true, // 空き家3,000万円特別控除の適用有無
      heirs: 1, // 相続人数（換価分割の目安）
      lastShareText: "",
      overrides: {
        land: false,
        demo: false,
        res: false,
        maint: false,
      },
    };

    const elPref = document.getElementById("disp-pref");
    const elCase = document.getElementById("disp-case");
    const elManLand = document.getElementById("man-land");
    const elManDemo = document.getElementById("man-demo");
    const elManRes = document.getElementById("man-res");
    const elManMaint = document.getElementById("man-maint");
    const elSubsidy = document.getElementById("man-subsidy");

    function ageToGroup(years) {
      if (years >= 45) return "old45";
      if (years < 30) return "new25";
      return "mid35";
    }

    function syncAgeButtonsUI() {
      document.querySelectorAll(".age-btn").forEach((btn) => {
        const on = btn.getAttribute("data-age") === state.ageGroup;
        btn.className =
          "age-btn rounded-xs border py-2 px-2 text-center text-[11px] font-bold transition-colors " +
          (on ? "border-emerald-700 bg-emerald-700 text-white" : "border-slate-300 bg-white text-slate-600 hover:bg-slate-50");
      });
    }

    function syncPresetButtonsUI() {
      const currentSlug = elCase.value;
      document.querySelectorAll(".preset-btn").forEach((btn) => {
        const on = btn.getAttribute("data-preset-slug") === currentSlug;
        btn.className =
          "preset-btn rounded-xs border py-2 px-2.5 text-left transition-colors " +
          (on ? "border-emerald-700 bg-emerald-700 text-white" : "border-slate-300 bg-white text-slate-700 hover:bg-slate-50");
      });
    }

    // URLパラメータ連動 (?pref=tokyo&case=wood-30tsubo-age40)
    const params = new URLSearchParams(window.location.search);
    if (params.get("pref") && byPref[params.get("pref")]) {
      elPref.value = params.get("pref");
    }
    if (params.get("case") && byCase[params.get("case")]) {
      elCase.value = params.get("case");
      state.ageGroup = ageToGroup(byCase[params.get("case")].building_age_years || 38);
      syncAgeButtonsUI();
      syncPresetButtonsUI();
    }

    function yen(n) {
      return `${Math.round(n).toLocaleString("ja-JP")}円`;
    }

    function signedYen(n) {
      const r = Math.round(n);
      if (r > 0) return `+${r.toLocaleString("ja-JP")}円`;
      if (r < 0) return `▲${Math.abs(r).toLocaleString("ja-JP")}円`;
      return "±0円";
    }

    function signedMan(n) {
      const man = Math.round(n / 10000);
      if (man > 0) return `+${man.toLocaleString("ja-JP")}万円`;
      if (man < 0) return `▲${Math.abs(man).toLocaleString("ja-JP")}万円`;
      return "±0万円";
    }

    function plainMan(n) {
      return `${Math.round(Math.abs(n) / 10000).toLocaleString("ja-JP")}万円`;
    }

    function calcBrokerFee(priceYen) {
      if (priceYen <= 0) return 0;
      const r = taxRulesData.sale_and_kaitori_rules;
      if (priceYen <= r.low_price_threshold_yen) {
        return Math.min(r.low_price_brokerage_max_yen, Math.round(priceYen * 0.15));
      }
      return Math.round((priceYen * r.brokerage_fee_rate + r.brokerage_fee_fixed_yen) * 1.1);
    }

    function getEffectiveAgeYears(c) {
      if (state.ageGroup === "old45") return Math.max(46, c.building_age_years || 46);
      if (state.ageGroup === "new25") return 24;
      return 38;
    }

    function computeAutoDefaults() {
      const pref = byPref[elPref.value];
      const c = byCase[elCase.value];
      const effAge = getEffectiveAgeYears(c);
      const hasAsbestos = effAge >= 25 && (c.has_asbestos_risk !== false);

      const locFactor =
        state.loc === "urban" ? 1.25 : state.loc === "rural" ? 0.42 : state.loc === "wakeari" ? 0.48 : 0.92;
      const caseFactor = c.market_demand_factor || 1.0;

      if (c.slug === "old-mansion-70sqm-age42") {
        const mansionMan = Math.max(
          250,
          Math.round((1280 * Math.pow(pref.land_price_man_per_tsubo / 24.5, 0.55) * (state.loc === "urban" ? 1.2 : state.loc === "rural" ? 0.65 : 1.0)) / 10) * 10,
        );
        const resMan = state.cond === "clean" ? 8 : state.cond === "damaged" ? 45 : 22;
        return { landMan: mansionMan, demoMan: 0, resMan, baseMaintMan: 36 };
      }

      const landMan = Math.max(
        50,
        Math.round((c.land_tsubo * pref.land_price_man_per_tsubo * locFactor * caseFactor) / 10) * 10,
      );

      let unitMan = pref.wood_man_per_tsubo;
      if (c.structure === "rc") unitMan = pref.rc_man_per_tsubo;
      else if (c.structure === "steel") unitMan = pref.steel_man_per_tsubo;
      if (c.slug.includes("hiraya")) unitMan *= 1.12;

      const roadMult = state.loc === "wakeari" || c.road_condition === "narrow" ? 1.24 : c.road_condition === "slope" ? 1.28 : 1.0;
      const bodyMan = c.floor_tsubo * unitMan * roadMult;
      const extMan = c.floor_tsubo >= 45 ? 32 : 22;
      const asbMan = hasAsbestos ? 24 : 0;
      const demoMan = Math.round((bodyMan + extMan + asbMan) / 5) * 5;

      const resMan = state.cond === "clean" ? 8 : state.cond === "damaged" ? 58 : 28;
      const ageMaintAdd = effAge >= 45 ? 3 : effAge < 30 ? -3 : 0;
      const baseMaintMan = Math.max(8, Math.round((21.7 + (c.annual_extra_maint_yen || 0) / 10000) + (state.cond === "damaged" ? 6 : 0) + ageMaintAdd));

      return { landMan, demoMan, resMan, baseMaintMan };
    }

    function syncAutoFields(forceAll = false) {
      const auto = computeAutoDefaults();
      if (forceAll || !state.overrides.land) elManLand.value = String(auto.landMan);
      if (forceAll || !state.overrides.demo) elManDemo.value = String(auto.demoMan);
      if (forceAll || !state.overrides.res) elManRes.value = String(auto.resMan);
      if (forceAll || !state.overrides.maint) elManMaint.value = String(auto.baseMaintMan);
    }

    function calcTransferTax(salePriceYen, transferExpenseYen, useExempt, heirsCount = 1) {
      if (salePriceYen <= 0) return 0;
      // 親の購入時契約書が不明な場合の法定5%概算取得費・長期譲渡所得税率20.315%
      // 2024年1月改正：相続人1〜2人は1人上限3,000万円、相続人3人以上は1人上限2,000万円（譲渡対価1億円以下が要件）
      const assumedAcquisitionCost = Math.round(salePriceYen * 0.05);
      const totalGain = Math.max(0, salePriceYen - assumedAcquisitionCost - transferExpenseYen);
      if (!useExempt || salePriceYen > 100000000) {
        return Math.round(totalGain * 0.20315);
      }
      const n = Math.max(1, heirsCount);
      const perHeirLimit = n >= 3 ? 20000000 : 30000000;
      const perHeirTaxable = Math.max(0, totalGain / n - perHeirLimit);
      return Math.round(perHeirTaxable * 0.20315 * n);
    }

    function syncExemptButtonsUI(eligible, reasonText) {
      const btnYes = document.getElementById("exempt-yes-btn");
      const btnNo = document.getElementById("exempt-no-btn");
      const subYes = document.getElementById("exempt-yes-sub");
      const hint = document.getElementById("exempt-ui-hint");
      if (!btnYes || !btnNo) return;

      if (!eligible) {
        btnYes.disabled = true;
        btnYes.className =
          "exempt-btn rounded-xs border border-slate-200 bg-slate-100 py-2 px-2 text-left text-[11px] font-bold text-slate-400 cursor-not-allowed transition-colors";
        btnNo.className =
          "exempt-btn rounded-xs border border-emerald-700 bg-emerald-700 py-2 px-2 text-left text-[11px] font-bold text-white transition-colors";
        if (subYes) subYes.textContent = "現在の条件では対象外";
        if (hint) {
          hint.textContent = reasonText;
          hint.classList.remove("hidden");
        }
      } else {
        btnYes.disabled = false;
        if (subYes) subYes.textContent = state.heirs >= 3 ? "1人2,000万円まで非課税" : "3,000万円まで譲渡税0円";
        btnYes.className =
          "exempt-btn rounded-xs border py-2 px-2 text-left text-[11px] font-bold transition-colors " +
          (state.taxExempt ? "border-emerald-700 bg-emerald-700 text-white" : "border-slate-300 bg-white text-slate-700 hover:bg-slate-50");
        btnNo.className =
          "exempt-btn rounded-xs border py-2 px-2 text-left text-[11px] font-bold transition-colors " +
          (!state.taxExempt ? "border-emerald-700 bg-emerald-700 text-white" : "border-slate-300 bg-white text-slate-700 hover:bg-slate-50");
        if (hint) hint.classList.add("hidden");
      }
    }

    function recalc() {
      const pref = byPref[elPref.value];
      const c = byCase[elCase.value];
      const years = state.spanYears;
      const effAge = getEffectiveAgeYears(c);

      const landMarketYen = Math.max(0, Number(elManLand.value) || 0) * 10000;
      const demoBodyAndExtYen = Math.max(0, Number(elManDemo.value) || 0) * 10000;
      const subsidyYen = Math.min(demoBodyAndExtYen, Math.max(0, Number(elSubsidy?.value) || 0) * 10000);
      const netDemoBodyYen = Math.max(0, demoBodyAndExtYen - subsidyYen);
      const resYen = Math.max(0, Number(elManRes.value) || 0) * 10000;
      const maintAnnualYen = Math.max(0, Number(elManMaint.value) || 0) * 10000;
      const totalDemoWithResYen = netDemoBodyYen + resYen;

      // 固定資産税・都市計画税計算
      const landSqm = c.land_tsubo * 3.305785;
      const landAssessed = Math.round(landMarketYen * 0.7);
      const smallRatio = Math.min(1.0, 200.0 / Math.max(1.0, landSqm));
      const genRatio = Math.max(0.0, 1.0 - smallRatio);

      const normalLandTax = Math.round(
        landAssessed * (smallRatio * (1 / 6) + genRatio * (1 / 3)) * 0.014 +
          landAssessed * (smallRatio * (1 / 3) + genRatio * (2 / 3)) * 0.003,
      );
      const heavyLandTax = Math.round(landAssessed * 0.7 * 0.017);

      const bldgBaseMan = c.structure === "rc" ? 45 : c.structure === "steel" ? 36 : 28;
      const dep = effAge >= 40 ? 0.14 : effAge < 30 ? 0.26 : 0.18;
      const bldgAssessed = Math.round(c.floor_tsubo * bldgBaseMan * 10000 * dep);
      const bldgTax = Math.round(bldgAssessed * 0.017);

      const normalTaxAnnual = normalLandTax + bldgTax;
      const heavyTaxAnnual = heavyLandTax + bldgTax;
      const sarachiTaxAnnual = heavyLandTax;

      // ① 空き家維持時の累積負担
      let keepTaxTotal = 0;
      let heavyYearsCount = 0;
      for (let y = 1; y <= years; y++) {
        const isHeavy = (state.cond === "damaged" && y >= 2) || (state.cond === "normal" && effAge >= 45 && y >= 4) || (state.cond === "normal" && y >= 5);
        if (isHeavy) {
          keepTaxTotal += heavyTaxAnnual;
          heavyYearsCount++;
        } else {
          keepTaxTotal += normalTaxAnnual;
        }
      }
      const keepMaintTotal = maintAnnualYen * years;
      const keepTotalOutflow = keepTaxTotal + keepMaintTotal;
      const keepNet = -keepTotalOutflow;

      // ② 解体して更地仲介売却
      const isMansion = c.slug === "old-mansion-70sqm-age42";
      const isOver100M = landMarketYen > 100000000;
      // 空き家3,000万円特別控除の法定要件：昭和56年（1981年）5月31日以前建築（築45年以上）の戸建て＋売却代金1億円以下
      const isExemptEligible = !isMansion && effAge >= 45 && !isOver100M;
      const effectiveTaxExempt = isExemptEligible && state.taxExempt;
      const exemptDisqualifyReason = isMansion
        ? "※区分マンションは空き家3,000万円特別控除の対象外です。"
        : isOver100M
          ? "※売却代金が1億円を超える場合は空き家3,000万円特別控除の対象外です。"
          : "※昭和56年（1981年）5月31日以前建築の戸建てが要件のため、築45年未満は自動で対象外にしています。";
      syncExemptButtonsUI(isExemptEligible, exemptDisqualifyReason);

      let sarachiGross = landMarketYen;
      if (state.loc === "wakeari" || c.slug === "non-rebuildable-wood-25tsubo") {
        sarachiGross = Math.round(landMarketYen * 0.38);
      } else if (c.slug === "leased-land-shakuchi-28tsubo") {
        sarachiGross = 0;
      }
      const sarachiBroker = calcBrokerFee(sarachiGross);
      const waitYears = state.loc === "rural" ? 2 : 1;
      const sarachiWaitTax = sarachiTaxAnnual * waitYears;
      const sarachiTransferTax = calcTransferTax(sarachiGross, netDemoBodyYen + sarachiBroker, effectiveTaxExempt, state.heirs);
      const sarachiNet = sarachiGross - totalDemoWithResYen - sarachiBroker - sarachiWaitTax - sarachiTransferTax;

      // ③ 解体せず売却（A: 古家付き仲介 / B: 残置物込み専門買取）
      let furuyaGross = Math.max(0, Math.round(landMarketYen * 0.96 - demoBodyAndExtYen * 0.82));
      if (isMansion) {
        furuyaGross = Math.round(landMarketYen * 0.94);
      } else if (c.slug === "leased-land-shakuchi-28tsubo") {
        // 借地権付き実家は地主への譲渡承諾料等を差し引いた借地権実勢で試算
        furuyaGross = Math.round(landMarketYen * 0.48);
      } else if (effAge < 30 && state.cond !== "damaged" && state.loc !== "wakeari") {
        furuyaGross = Math.round(landMarketYen * 1.05 + 1800000);
      }
      const furuyaBroker = calcBrokerFee(furuyaGross);
      const furuyaTransferTax = calcTransferTax(furuyaGross, furuyaBroker, effectiveTaxExempt, state.heirs);
      const furuyaNet = furuyaGross - furuyaBroker - resYen - normalTaxAnnual - furuyaTransferTax;

      let kaitoriGross = Math.round(landMarketYen * 0.72 - demoBodyAndExtYen * 0.42);
      if (state.loc === "wakeari" || c.category === "wakeari") {
        kaitoriGross = Math.max(Math.round(landMarketYen * 0.56), 600000);
      } else if (state.loc === "rural" || state.cond === "damaged") {
        kaitoriGross = Math.max(Math.round(landMarketYen * 0.62 - demoBodyAndExtYen * 0.35), 550000);
      } else {
        kaitoriGross = Math.max(kaitoriGross, Math.round(landMarketYen * 0.48), 500000);
      }
      const kaitoriTransferTax = calcTransferTax(kaitoriGross, 0, effectiveTaxExempt, state.heirs);
      const kaitoriNet = kaitoriGross - kaitoriTransferTax;

      // 主軸ルートと最終手残りを100%一致させ、詳細テーブルの足し算に矛盾が出ないようにする
      const useKaitoriAsMain =
        state.loc === "wakeari" || c.category === "wakeari" || kaitoriNet >= furuyaNet;
      const asIsNet = useKaitoriAsMain ? kaitoriNet : furuyaNet;
      const asIsTransferTax = useKaitoriAsMain ? kaitoriTransferTax : furuyaTransferTax;
      const asIsShortTitle = useKaitoriAsMain ? "③ そのまま買取" : "③ 壊さず売却";
      const asIsFullLabel = useKaitoriAsMain ? "壊さず専門買取" : "壊さず古家付き売却";

      // UI更新
      const isManual = Object.values(state.overrides).some(Boolean);
      document.getElementById("premise-mode-badge").textContent = isManual ? "手動調整を反映中" : `${pref.name}の公的統計から自動試算`;
      document.getElementById("verdict-eyebrow").textContent = `${years}年間の手残り・維持費シミュレーション`;

      // カード① 空き家維持（2行の左右揃えリストで改行落ちゼロ）
      document.getElementById("val-keep").textContent = signedMan(keepNet);
      document.getElementById("sub-keep").textContent = `年平均 ▲${plainMan(keepTotalOutflow / years)}/年`;
      document.getElementById("note-keep").innerHTML =
        `<div class="flex justify-between whitespace-nowrap"><span>固定資産税計</span><span class="font-semibold text-slate-700">${plainMan(keepTaxTotal)}</span></div>` +
        `<div class="flex justify-between whitespace-nowrap"><span>維持・修繕計</span><span class="font-semibold text-slate-700">${plainMan(keepMaintTotal)}</span></div>`;

      // カード② 解体して更地売却（区分マンション時は片付け後仲介売却）
      const sarachiCostTotal = totalDemoWithResYen + sarachiBroker + sarachiWaitTax + sarachiTransferTax;
      document.getElementById("title-sarachi").textContent = isMansion ? "② 片付け後仲介" : "② 更地で売却";
      document.getElementById("val-sarachi").textContent = signedMan(sarachiNet);
      document.getElementById("sub-sarachi").textContent = isMansion
        ? `戸別解体不要・片付け約${plainMan(resYen)}`
        : `先行手出し 約${plainMan(totalDemoWithResYen)}`;
      document.getElementById("note-sarachi").innerHTML =
        `<div class="flex justify-between whitespace-nowrap"><span>${isMansion ? "マンション売却額" : "土地売却額"}</span><span class="font-semibold text-slate-700">${plainMan(sarachiGross)}</span></div>` +
        `<div class="flex justify-between whitespace-nowrap"><span>${isMansion ? "片付け・税・諸費" : "解体・税・諸費"}</span><span class="font-semibold text-rose-700">▲${plainMan(sarachiCostTotal)}</span></div>`;

      // カード③ 壊さず手放す
      const asIsGrossDisp = useKaitoriAsMain ? kaitoriGross : furuyaGross;
      const asIsCostDisp = useKaitoriAsMain ? kaitoriTransferTax : furuyaBroker + resYen + normalTaxAnnual + furuyaTransferTax;
      document.getElementById("title-as-is").textContent = asIsShortTitle;
      document.getElementById("val-as-is").textContent = signedMan(asIsNet);
      document.getElementById("sub-as-is").textContent = useKaitoriAsMain
        ? "先行手出し 0円"
        : `先行片付け 約${plainMan(resYen)}`;
      document.getElementById("note-as-is").innerHTML =
        `<div class="flex justify-between whitespace-nowrap"><span>${useKaitoriAsMain ? "直接買取額" : "古家付売却"}</span><span class="font-semibold text-slate-700">${plainMan(asIsGrossDisp)}</span></div>` +
        `<div class="flex justify-between whitespace-nowrap"><span>税・諸経費</span><span class="font-semibold text-emerald-800">${asIsCostDisp === 0 ? "0円（不要）" : `▲${plainMan(asIsCostDisp)}`}</span></div>`;

      document.getElementById("res-furuya-broker").textContent = signedMan(furuyaNet);
      document.getElementById("res-direct-kaitori").textContent = signedMan(kaitoriNet);

      // おすすめ判定
      const asIsWins = asIsNet >= sarachiNet;
      const bestNet = Math.max(asIsNet, sarachiNet);
      const diffVsKeep = bestNet - keepNet;
      const diffBetweenSale = Math.abs(asIsNet - sarachiNet);

      // きょうだい分配（換価分割の目安）
      const perHeirNet = Math.round(bestNet / state.heirs);
      document.getElementById("heir-share-note").textContent =
        state.heirs === 1
          ? `単独相続の手残り目安：${signedMan(bestNet)}`
          : `${state.heirs}人で分けると 1人あたり ${signedMan(perHeirNet)}`;

      // 診断結果に応じた動的CTAの自動切替（5枠：借地権 / 訳あり買取 / 一般空き家買取 / 売却相談 / 解体）
      const isShakuchi = c.slug === "leased-land-shakuchi-28tsubo";
      const isWakeariCase = state.loc === "wakeari" || c.category === "wakeari";
      const activeCtaSlot = isShakuchi
        ? "shakuchi"
        : !asIsWins
          ? "kaitai"
          : useKaitoriAsMain
            ? isWakeariCase
              ? "akiya"
              : "akiya_house"
            : "sell";
      ["sell", "akiya", "akiya_house", "shakuchi", "kaitai"].forEach((slot) => {
        const el = document.getElementById(`cta-wrap-${slot}`);
        if (el) el.classList.toggle("hidden", slot !== activeCtaSlot);
      });

      const cardSarachi = document.getElementById("card-sarachi");
      const cardAsIs = document.getElementById("card-as-is");
      const tagSarachi = document.getElementById("tag-sarachi");
      const tagAsIs = document.getElementById("tag-as-is");
      const valSarachi = document.getElementById("val-sarachi");
      const valAsIs = document.getElementById("val-as-is");

      if (asIsWins) {
        cardAsIs.className = "rounded border border-emerald-300 border-t-3 border-t-emerald-700 bg-white p-3.5 flex flex-col justify-between transition-colors shadow-2xs min-w-0";
        cardSarachi.className = "rounded border border-slate-200 border-t-3 border-t-slate-300 bg-slate-50/70 p-3.5 flex flex-col justify-between transition-colors min-w-0";
        valAsIs.className = "mt-2 font-display text-xl font-extrabold text-emerald-800 tabular-nums whitespace-nowrap";
        valSarachi.className = "mt-2 font-display text-xl font-extrabold text-slate-800 tabular-nums whitespace-nowrap";
        tagAsIs.classList.remove("hidden");
        tagSarachi.classList.add("hidden");
      } else {
        cardSarachi.className = "rounded border border-emerald-300 border-t-3 border-t-emerald-700 bg-white p-3.5 flex flex-col justify-between transition-colors shadow-2xs min-w-0";
        cardAsIs.className = "rounded border border-slate-200 border-t-3 border-t-slate-300 bg-slate-50/70 p-3.5 flex flex-col justify-between transition-colors min-w-0";
        valSarachi.className = "mt-2 font-display text-xl font-extrabold text-emerald-800 tabular-nums whitespace-nowrap";
        valAsIs.className = "mt-2 font-display text-xl font-extrabold text-slate-800 tabular-nums whitespace-nowrap";
        tagSarachi.classList.remove("hidden");
        tagAsIs.classList.add("hidden");
      }

      const bestStrategyTitle = asIsWins ? asIsFullLabel : isMansion ? "片付け後の仲介売却" : "解体して更地売却";
      document.getElementById("verdict-winner").textContent = `「${bestStrategyTitle}」が +${plainMan(diffBetweenSale)} 有利`;
      document.getElementById("verdict-diff-note").textContent =
        `${years}年維持と比べ 合計 +${plainMan(diffVsKeep)} の資産防衛`;

      const mobLbl = document.getElementById("disp-mob-label");
      const mobVal = document.getElementById("disp-mob-value");
      if (mobLbl) mobLbl.textContent = `最有力：${bestStrategyTitle}`;
      if (mobVal) mobVal.textContent = `手残り目安 ${signedMan(bestNet)}`;

      // 3つのメリット（それぞれ簡潔な1行に収まる長さに最適化）
      const benefits = asIsWins
        ? [
            `<li><strong>先行出費リスクなし：</strong>先に解体・片付け費（約${plainMan(totalDemoWithResYen)}）を自己負担せずに手放せます</li>`,
            effAge >= 45
              ? `<li><strong>3,000万円控除対応：</strong>古家付きで売って買主が翌年2月15日までに解体しても特別控除が使えます</li>`
              : effAge < 30
                ? `<li><strong>建物の価値をプラス：</strong>築30年未満のためリフォーム向け中古戸建てとして建物ごと評価されます</li>`
                : `<li><strong>税金の軽減を維持：</strong>引き渡しまで建物があるため住宅用地の軽減（固定資産税1/6）が守られます</li>`,
            `<li><strong>維持費をストップ：</strong>${years}年間の税金・草刈り・修繕負担（計 約${plainMan(keepTotalOutflow)}）を解消できます</li>`,
          ]
        : [
            `<li><strong>更地需要で高値売却：</strong>解体費（約${plainMan(totalDemoWithResYen)}）を差し引いても更地の方が手残りが最大化します</li>`,
            `<li><strong>3,000万円特別控除：</strong>要件を満たせば譲渡所得から最大3,000万円が控除され譲渡税を抑えられます</li>`,
            `<li><strong>維持費を資産へ転換：</strong>${years}年間の維持負担（約${plainMan(keepTotalOutflow)}）を払う前に約${plainMan(bestNet)}を残せます</li>`,
          ];
      document.getElementById("verdict-benefits").innerHTML = benefits.join("");

      // 詳細テーブル更新（PC幅で横スクロールせず収まる簡潔表記）
      const rows = [
        ["売却想定額（収入）", "0円", `+${yen(sarachiGross)}`, `+${yen(asIsGrossDisp)}`],
        [
          subsidyYen > 0 ? `解体・外構費（補助▲${plainMan(subsidyYen)}）` : "解体・外構撤去費",
          "0円",
          isMansion ? "0円" : `▲${yen(netDemoBodyYen)}`,
          "0円",
        ],
        ["家財片付け費", "0円", `▲${yen(resYen)}`, useKaitoriAsMain ? "0円" : `▲${yen(resYen)}`],
        ["仲介手数料（税込）", "0円", `▲${yen(sarachiBroker)}`, useKaitoriAsMain ? "0円" : `▲${yen(furuyaBroker)}`],
        [
          effectiveTaxExempt
            ? `譲渡所得税（${state.heirs >= 3 ? "各2,000万" : "3,000万"}控除）`
            : "譲渡所得税（20.315%）",
          "0円",
          sarachiTransferTax > 0 ? `▲${yen(sarachiTransferTax)}` : "0円",
          asIsTransferTax > 0 ? `▲${yen(asIsTransferTax)}` : "0円",
        ],
        [
          `固定資産税（${years}年 / 待期）`,
          `▲${yen(keepTaxTotal)}`,
          `▲${yen(sarachiWaitTax)}`,
          useKaitoriAsMain ? "0円" : `▲${yen(normalTaxAnnual)}`,
        ],
        [`維持・草刈り・修繕（${years}年）`, `▲${yen(keepMaintTotal)}`, "0円", "0円"],
        [
          `最終手残り収支（${years}年）`,
          signedYen(keepNet),
          signedYen(sarachiNet),
          signedYen(asIsNet),
        ],
      ];

      document.getElementById("disp-tbody").innerHTML = rows
        .map(([label, a, b, d], idx) => {
          const isLast = idx === rows.length - 1;
          return `<tr class="${isLast ? "bg-slate-50 font-extrabold text-slate-900" : ""}">
            <td class="py-2.5 pr-2 text-slate-700 ${isLast ? "font-extrabold" : "font-medium"}">${label}</td>
            <td class="py-2.5 px-2 text-right whitespace-nowrap text-rose-700">${a}</td>
            <td class="py-2.5 px-2 text-right whitespace-nowrap ${!asIsWins && isLast ? "text-emerald-800" : ""}">${b}</td>
            <td class="py-2.5 pl-2 text-right whitespace-nowrap ${asIsWins && isLast ? "text-emerald-800" : ""}">${d}</td>
          </tr>`;
        })
        .join("");

      // 3,000万円特別控除の節税インパクト表示
      const bestGrossForTax = !asIsWins ? sarachiGross : asIsGrossDisp;
      const bestExpForTax = !asIsWins ? netDemoBodyYen + sarachiBroker : useKaitoriAsMain ? 0 : furuyaBroker;
      const taxWithExempt = calcTransferTax(bestGrossForTax, bestExpForTax, true, state.heirs);
      const taxWithoutExempt = calcTransferTax(bestGrossForTax, bestExpForTax, false, state.heirs);
      const taxSavingYen = Math.max(0, taxWithoutExempt - taxWithExempt);
      const heirLimitLabel = state.heirs >= 3 ? `1人上限2,000万円（${state.heirs}人計 最大${state.heirs * 2000}万円）` : state.heirs === 2 ? "1人上限3,000万円（2人計 最大6,000万円）" : "上限3,000万円";
      const taxBox = document.getElementById("tax-impact-box");
      if (!isExemptEligible) {
        taxBox.className = "mt-4 rounded-xs border border-amber-300 bg-amber-50/70 px-3.5 py-2.5 text-xs text-slate-800 leading-relaxed";
        const reasonLabel = isMansion
          ? "区分マンション"
          : isOver100M
            ? "売却代金1億円超"
            : "昭和56年（1981年）6月以降の建築（築45年未満）";
        taxBox.innerHTML =
          `<strong>空き家3,000万円特別控除の対象外条件：</strong>${reasonLabel}は法定要件の対象外のため、譲渡所得税（約<strong class="text-rose-700">${plainMan(taxWithoutExempt)}</strong>・取得費不明5%概算）を差し引いています。${!isMansion && !isOver100M ? "昭和56年5月31日以前の旧耐震戸建てなら、STEP 2で「築45年以上」を選ぶと控除ありで試算できます。" : ""}親の購入時の売買契約書が見つかれば取得費を差し引いて大きく節税できます。` +
          ` <a href="/tools/inheritance-deadline/" class="font-bold text-emerald-800 hover:underline whitespace-nowrap">特例の6要件を確認 →</a>`;
      } else if (effectiveTaxExempt) {
        taxBox.className = "mt-4 rounded-xs border border-emerald-200 bg-emerald-50/50 px-3.5 py-2.5 text-xs text-slate-700 leading-relaxed";
        taxBox.innerHTML =
          `<strong>空き家3,000万円特別控除の効果（${heirLimitLabel}）：</strong>購入時の契約書が不明（5%概算取得費）の場合、控除を逃すと譲渡所得税が<strong class="text-rose-700">約${plainMan(taxSavingYen)}</strong>増えます。相続開始から<strong>3年目の12月31日</strong>までの売却が期限です。` +
          ` <a href="/tools/inheritance-deadline/" class="font-bold text-emerald-700 hover:underline whitespace-nowrap">締切日と6つの要件を確認 →</a>`;
      } else {
        taxBox.className = "mt-4 rounded-xs border border-amber-300 bg-amber-50/70 px-3.5 py-2.5 text-xs text-slate-800 leading-relaxed";
        taxBox.innerHTML =
          `<strong>譲渡所得税の影響（控除なし試算中）：</strong>取得費不明（5%概算）・長期譲渡20.315%として<strong class="text-rose-700">約${plainMan(taxWithoutExempt)}</strong>の税金を差し引いています。空き家3,000万円特別控除（${heirLimitLabel}）の要件を満たせば<strong>約${plainMan(taxSavingYen)}</strong>手残りが増えます。` +
          ` <a href="/tools/inheritance-deadline/" class="font-bold text-emerald-800 hover:underline whitespace-nowrap">対象になるか6問で確認 →</a>`;
      }

      const ageLabel = state.ageGroup === "old45" ? "築45年以上（昭和56年以前）" : state.ageGroup === "new25" ? "築30年未満" : "築30〜44年（昭和57年〜）";
      const subsidyNote = subsidyYen > 0 ? `／解体補助金 ${plainMan(subsidyYen)}` : "";
      document.getElementById("auto-premise-box").innerHTML =
        `<strong>試算の前提条件（${isManual ? "手動調整反映中" : "地域相場モデル自動試算"}）：</strong>` +
        `${pref.name}（木造解体目安 ${pref.wood_man_per_tsubo.toFixed(2)}万円/坪・標準地価 ${pref.land_price_man_per_tsubo.toFixed(1)}万円/坪）／` +
        `延床${c.floor_tsubo}坪・敷地${c.land_tsubo}坪・${ageLabel}${subsidyNote}／` +
        `特別控除：${effectiveTaxExempt ? `適用あり（${heirLimitLabel}）` : !isExemptEligible ? "対象外（自動オフ）" : "なし"}／通常固定資産税 年${yen(normalTaxAnnual)}`;

      // LINE・メール共有用テキストを生成して保持
      const heirLine = state.heirs > 1 ? `\n・${state.heirs}人で分けた場合：1人あたり ${signedMan(perHeirNet)}` : "";
      state.lastShareText =
        `【実家と空き家の試算表｜手残りシミュレーション結果】\n` +
        `条件：${pref.name} / 延床${c.floor_tsubo}坪・敷地${c.land_tsubo}坪 / ${ageLabel} / 3,000万円控除${effectiveTaxExempt ? "あり" : "なし"}\n` +
        `──────────────\n` +
        `最有力ルート：${bestStrategyTitle}（手残り目安 ${signedMan(bestNet)}）${heirLine}\n` +
        `① 空き家まま${years}年維持：${signedMan(keepNet)}（年平均 ▲${plainMan(keepTotalOutflow / years)}）\n` +
        `② 解体して更地売却：${signedMan(sarachiNet)}（解体・片付け目安 ${plainMan(totalDemoWithResYen)}）\n` +
        `③ 壊さず売却/買取：${signedMan(asIsNet)}（古家付仲介 ${signedMan(furuyaNet)} / 専門買取 ${signedMan(kaitoriNet)}）\n` +
        `──────────────\n` +
        `試算ページ：${window.location.origin}${window.location.pathname}?pref=${pref.slug}`;

      const warnText =
        state.loc === "wakeari"
          ? `<p class="text-rose-800 font-bold">【重要】道が狭い・建て替え不可（再建築不可）の実家についての注意点：先に建物を解体して更地にしてしまうと、新しい家が建てられず土地の価値が大きく下がってしまいます。絶対に先に自費で解体せず、「建物のまま」専門会社へ相談してください。</p>`
          : sarachiNet < 0
            ? `<p class="text-amber-900 font-bold">【注意】先に解体すると費用倒れになる可能性があります：この条件では解体工事費（約${plainMan(totalDemoWithResYen)}）が土地の売却額を上回りやすいため、ご自身で解体費を払わず「そのまま買取」または「古家付き売却」を選ぶのが安全です。</p>`
            : `<p><strong>「先に解体しなくてもいい」理由：</strong>以前は3,000万円特別控除を使うために売主が解体する必要がありましたが、<strong>2024年（令和6年）の税制改正により、古家付きで売って買主が翌年2月15日までに解体した場合でも控除が使える</strong>ようになりました。まずは壊さずに査定を取るのが安心です。</p>`;

      document.getElementById("disp-insight").innerHTML =
        warnText +
        `<p><strong>空き家のまま置いておく場合の目安：</strong>この実家を${years}年間維持すると、固定資産税と最低限の維持費（草刈り・水道光熱基本料・保険・修繕）で<strong>合計 約${plainMan(keepTotalOutflow)}（月あたり 約${(keepTotalOutflow / (years * 12) / 10000).toFixed(1)}万円）</strong>の負担になります。ご家族で方針を話し合う際の目安になさってください。</p>`;
    }

    function setGroupActive(selector, activeEl) {
      document.querySelectorAll(selector).forEach((b) => {
        const on = b === activeEl;
        b.className =
          b.className
            .replace(/border-emerald-700|bg-emerald-700|text-white|border-slate-300|bg-white|text-slate-600|text-slate-700/g, "")
            .trim() + (on ? " border-emerald-700 bg-emerald-700 text-white" : " border-slate-300 bg-white text-slate-700");
      });
    }

    document.querySelectorAll(".preset-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const slug = btn.getAttribute("data-preset-slug");
        if (slug && byCase[slug]) {
          elCase.value = slug;
          state.ageGroup = ageToGroup(byCase[slug].building_age_years || 38);
          syncPresetButtonsUI();
          syncAgeButtonsUI();
          state.overrides = { land: false, demo: false, res: false, maint: false };
          syncAutoFields();
          recalc();
        }
      });
    });

    document.querySelectorAll(".age-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        state.ageGroup = btn.getAttribute("data-age");
        syncAgeButtonsUI();
        state.overrides.demo = false;
        state.overrides.maint = false;
        syncAutoFields();
        recalc();
      });
    });

    document.querySelectorAll(".span-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        state.spanYears = Number(btn.getAttribute("data-span"));
        setGroupActive(".span-btn", btn);
        recalc();
      });
    });

    document.querySelectorAll(".loc-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        state.loc = btn.getAttribute("data-loc");
        setGroupActive(".loc-btn", btn);
        state.overrides.land = false;
        state.overrides.demo = false;
        syncAutoFields();
        recalc();
      });
    });

    document.querySelectorAll(".cond-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        state.cond = btn.getAttribute("data-cond");
        setGroupActive(".cond-btn", btn);
        state.overrides.res = false;
        state.overrides.maint = false;
        syncAutoFields();
        recalc();
      });
    });

    document.querySelectorAll(".exempt-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        state.taxExempt = btn.getAttribute("data-exempt") === "yes";
        setGroupActive(".exempt-btn", btn);
        recalc();
      });
    });

    document.querySelectorAll(".heir-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        state.heirs = Number(btn.getAttribute("data-heirs")) || 1;
        document.querySelectorAll(".heir-btn").forEach((b) => {
          const on = b === btn;
          b.className = b.className
            .replace(/bg-emerald-700|text-white|bg-white|text-slate-600/g, "")
            .trim() + (on ? " bg-emerald-700 text-white" : " bg-white text-slate-600");
        });
        recalc();
      });
    });

    document.getElementById("copy-result-btn").addEventListener("click", async () => {
      const labelEl = document.getElementById("copy-result-label");
      try {
        await navigator.clipboard.writeText(state.lastShareText);
        if (labelEl) {
          labelEl.textContent = "コピーしました";
          setTimeout(() => {
            labelEl.textContent = "LINE共有用にコピー";
          }, 2200);
        }
      } catch {
        window.prompt("以下の試算結果をコピーしてLINEやメールに貼り付けてください：", state.lastShareText);
      }
    });

    document.getElementById("print-result-btn").addEventListener("click", () => {
      window.print();
    });

    elPref.addEventListener("change", () => {
      state.overrides.land = false;
      state.overrides.demo = false;
      syncAutoFields();
      recalc();
    });

    elCase.addEventListener("change", () => {
      const c = byCase[elCase.value];
      if (c) {
        state.ageGroup = ageToGroup(c.building_age_years || 38);
        syncAgeButtonsUI();
      }
      syncPresetButtonsUI();
      state.overrides = { land: false, demo: false, res: false, maint: false };
      syncAutoFields();
      recalc();
    });

    [
      [elManLand, "land"],
      [elManDemo, "demo"],
      [elManRes, "res"],
      [elManMaint, "maint"],
    ].forEach(([el, key]) => {
      el.addEventListener("input", () => {
        state.overrides[key] = true;
        recalc();
      });
    });

    if (elSubsidy) {
      elSubsidy.addEventListener("change", recalc);
    }

    document.getElementById("reset-auto-btn").addEventListener("click", () => {
      state.overrides = { land: false, demo: false, res: false, maint: false };
      if (elSubsidy) elSubsidy.value = "0";
      syncAutoFields(true);
      recalc();
    });

    const mobBar = document.getElementById("disp-mobile-bar");
    const resPanel = document.getElementById("disp-result-panel");
    if (mobBar && resPanel && "IntersectionObserver" in window) {
      const updateMobBar = (entry) => {
        const shouldHide = Boolean(entry?.isIntersecting) || (entry ? entry.boundingClientRect.top < 0 : false);
        mobBar.classList.toggle("translate-y-full", shouldHide);
        mobBar.classList.toggle("opacity-0", shouldHide);
        mobBar.classList.toggle("pointer-events-none", shouldHide);
      };
      const io = new IntersectionObserver((entries) => updateMobBar(entries[0]), { threshold: 0.05 });
      io.observe(resPanel);
    }

    syncAutoFields(true);
    recalc();
  </script>
</BaseLayout>
