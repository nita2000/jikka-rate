---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CostTrendChart from "../../components/CostTrendChart.astro";
import AffiliateCta from "../../components/AffiliateCta.astro";
import prefectures from "../../data/prefectures.json";
import { formatDiffMan, formatManYen, formatSignedYen, formatYen, structureLabel } from "../../lib/formatters";

export function getStaticPaths() {
  const detailDir = path.resolve(process.cwd(), "src/data/pref_detail");
  return prefectures.map((pref) => {
    const raw = fs.readFileSync(path.join(detailDir, `${pref.slug}.json`), "utf-8");
    const detail = JSON.parse(raw);
    return {
      params: { pref: pref.slug },
      props: { pref, detail },
    };
  });
}

const { pref, detail } = Astro.props;

// 30坪木造解体費と45坪土地相場から、県内で解体費用倒れ（赤字）になりやすい境界地価を算出
const demo30Man = Math.round(pref.std_30tsubo_demolition_yen / 10000);
const stdLand45Man = Math.round(pref.land_price_man_per_tsubo * 45);
const breakevenLandPerTsuboMan = Math.max(1, Math.ceil((demo30Man + 35) / 45));
const isLowLandPricePref = pref.land_price_man_per_tsubo < 15;

// 地域ブロック固有の実家・空き家リスク特徴（47ページの固有情報を補強）
const regionRiskNoteMap: Record<string, { title: string; body: string; cases: Array<{ slug: string; label: string }> }> = {
  北海道: {
    title: "積雪・凍結による屋根破損と冬期解体の割増に注意",
    body: "積雪による屋根のたわみ・水道管破裂が1冬で進みやすく、冬季は除雪・養生費で解体見積もりが上振れする傾向があります。雪解け前から売却・買取の査定を進めておくと維持費を抑えられます。",
    cases: [
      { slug: "snow-country-wood-45tsubo", label: "豪雪地帯の木造45坪" },
      { slug: "kominka-farm-55tsubo-age60", label: "地方古民家55坪" },
      { slug: "remote-island-hokkaido-grave-2sqm", label: "超遠方のお墓2㎡" },
    ],
  },
  東北: {
    title: "広い敷地・雪害リスクにより「解体費用倒れ」が起きやすい地域",
    body: "延床40〜55坪超の木造実家が多く、先に解体すると200万〜300万円以上の持ち出しが土地価格を上回りやすいのが特徴です。雪下ろし負担が続く前に現状のまま買取・譲渡の可否を確認するのが安全です。",
    cases: [
      { slug: "snow-country-wood-45tsubo", label: "豪雪地帯の木造45坪" },
      { slug: "rural-farmland-attached-42tsubo", label: "農地付き実家42坪" },
      { slug: "shared-inheritance-undivided-32tsubo", label: "共有名義・未分割実家" },
    ],
  },
  関東: {
    title: "狭小道路・再建築不可・旧ニュータウンの擁壁と相続税評価に注意",
    body: "地価水準が高いため、解体して更地にするか古家付きで売るかで手残りが数百万円変わります。一方、旗竿地・接道2m未満の再建築不可物件や斜面擁壁付き住宅は、先に壊すと建て替え不可や擁壁補修費で大きく損をするため注意が必要です。",
    cases: [
      { slug: "non-rebuildable-wood-25tsubo", label: "再建築不可の木造25坪" },
      { slug: "slope-retaining-wall-30tsubo", label: "高低差・擁壁あり30坪" },
      { slug: "leased-land-shakuchi-28tsubo", label: "借地権付き実家28坪" },
    ],
  },
  中部: {
    title: "都市部と山間・農村部の地価差が大きく、エリア別判断が必須",
    body: "県庁所在地周辺の住宅地では更地・古家付き仲介で手残りを伸ばしやすい一方、郊外や山間部では解体費が売却額を上回りやすくなります。未登記の離れ・倉庫がある実家は相続登記と同時に整理が必要です。",
    cases: [
      { slug: "unregistered-extension-34tsubo", label: "未登記増築あり34坪" },
      { slug: "villa-resort-akiya-28tsubo", label: "別荘・リゾート空き家" },
      { slug: "heavy-residual-hoarder-32tsubo", label: "残置物大量の実家32坪" },
    ],
  },
  近畿: {
    title: "連棟長屋・狭小路地・市街化調整区域の扱いと残置物整理に注意",
    body: "旧市街地では切り離し工事が必要な長屋（連棟式）や重機が入れない狭小路地が多く、手壊し解体で坪単価が跳ね上がりやすい傾向があります。壊さず再生ノウハウのある専門買取との比較が有効です。",
    cases: [
      { slug: "nagaya-rowhouse-22tsubo-age50", label: "長屋・連棟式22坪" },
      { slug: "narrow-road-hand-demolition-28tsubo", label: "重機不可・狭小道路28坪" },
      { slug: "stigmatized-lonely-death-28tsubo", label: "孤独死・心理的瑕疵物件" },
    ],
  },
  中国: {
    title: "放置型空き家率が高く、老朽化による管理不全勧告リスクに注意",
    body: "全国平均を上回る空き家率の自治体が多く、屋根瓦のずれや雑草越境に対する自治体の指導・勧告が増えています。築古の農村実家や共有名義のまま放置された家屋は、早めの名義整理と買取相談が安心です。",
    cases: [
      { slug: "kominka-farm-55tsubo-age60", label: "地方古民家55坪" },
      { slug: "shared-inheritance-undivided-32tsubo", label: "共有名義・未分割実家" },
      { slug: "fire-damaged-akiya-30tsubo", label: "火災跡地・焼損実家" },
    ],
  },
  四国: {
    title: "空き家率全国上位エリア。解体補助金の事前確認と国庫帰属も視野に",
    body: "空き家率が全国トップクラスで買い手がつきにくい郊外エリアが多いため、自己資金で先に解体すると回収できないリスクが高まります。自治体補助金の上限確認とあわせ、現状買取や国庫帰属の条件も比較しておくと安全です。",
    cases: [
      { slug: "rural-farmland-attached-42tsubo", label: "農地付き実家42坪" },
      { slug: "termite-rainleak-damaged-30tsubo", label: "シロアリ・雨漏り実家" },
      { slug: "community-kyodo-grave-2sqm", label: "地方の共同墓地2㎡" },
    ],
  },
  "九州・沖縄": {
    title: "台風・シロアリ・塩害による劣化進行が早く、放置コストが膨らみやすい",
    body: "高温多湿・台風襲来により空き家の雨漏りやシロアリ被害が数年で進みやすく、隣家への屋根材飛散リスクが問題になりやすい地域です。RC造実家は解体費が高額になりやすいため、解体前に現状売却の可否を確認してください。",
    cases: [
      { slug: "termite-rainleak-damaged-30tsubo", label: "シロアリ・雨漏り実家" },
      { slug: "rc-35tsubo-age40", label: "RC造35坪（解体高額）" },
      { slug: "fire-damaged-akiya-30tsubo", label: "火災跡地・焼損実家" },
    ],
  },
};
const regionNote = regionRiskNoteMap[pref.region] || regionRiskNoteMap["中部"];

const prefFaqItems = [
  {
    q: `${pref.name}で木造30坪の実家を解体すると費用はいくらくらいですか？`,
    a: `${pref.latest_date}基準の${pref.name}における木造解体坪単価は平均${pref.wood_man_per_tsubo.toFixed(2)}万円/坪です。延床30坪の木造戸建ての場合、付帯撤去や石綿事前調査等を含めた解体総額の目安は約${demo30Man}万円です（前面道路が狭い場合や残置物が多い場合は上振れします）。`,
  },
  {
    q: `${pref.name}の空き家は先に解体して更地にするのと、そのまま売却・買取のどちらが有利ですか？`,
    a: `${pref.name}の標準住宅地地価（約${pref.land_price_man_per_tsubo.toFixed(1)}万円/坪）の場合、敷地45坪で土地評価は約${stdLand45Man.toLocaleString("ja-JP")}万円ですが、県内の郊外・地方で地価が坪${breakevenLandPerTsuboMan}万円を下回るエリアでは解体費（約${demo30Man}万円）が売却額を上回る費用倒れが起きやすくなります。2024年改正により古家付きで売って買主が翌年2月15日までに解体しても3,000万円特別控除が使えるため、まずは壊さずに査定・買取額を比較するのが安全です。`,
  },
  {
    q: `${pref.name}で空き家を放置して固定資産税の軽減（1/6特例）が外れると年いくら上がりますか？`,
    a: `${pref.name}の標準的な45坪住宅地では、通常時の固定資産税・都市計画税目安は年間${formatYen(pref.std_normal_tax_annual_yen)}ですが、管理不全空き家等の勧告や更地化で住宅用地の軽減が外れると年間${formatYen(pref.std_heavy_tax_annual_yen)}（年間約${formatYen(pref.std_heavy_tax_annual_yen - pref.std_normal_tax_annual_yen)}の増額）となります。`,
  },
];

const prefSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: prefFaqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<BaseLayout
  title={`${pref.name}の空き家率・解体工事坪単価・実家処分＆墓じまい相場`}
  description={`${pref.name}の総空き家率${pref.akiya_rate_pct.toFixed(1)}%（全国${pref.akiya_rank}位）・木造解体${pref.wood_man_per_tsubo.toFixed(2)}万円/坪・鉄骨${pref.steel_man_per_tsubo.toFixed(2)}万円/坪・RC${pref.rc_man_per_tsubo.toFixed(2)}万円/坪の推移と、県内での実家処分・固定資産税・墓じまい損益データを掲載。`}
  canonicalPath={`/pref/${pref.slug}/`}
  schema={prefSchema}
>
  <nav class="text-xs text-slate-500 mb-4 flex items-center gap-1.5">
    <a href="/" class="hover:text-emerald-700">トップ</a>
    <span>/</span>
    <a href="/pref/" class="hover:text-emerald-700">47都道府県別</a>
    <span>/</span>
    <span class="text-slate-800 font-semibold">{pref.name}</span>
  </nav>

  <div class="page-header-clean rounded p-5 sm:p-6 mb-6">
    <div class="flex flex-wrap items-center gap-2 mb-1">
      <span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 text-[11px] font-bold">{pref.region}エリア</span>
      <span class="text-xs text-slate-500 tabular-nums">
        空き家率 全国{pref.akiya_rank}位 ／ 解体安い順 全国{pref.kaitai_cheap_rank}位（{pref.latest_date}基準）
      </span>
    </div>
    <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900">
      {pref.name}の空き家率・解体工事坪単価・実家処分＆墓じまい相場
    </h1>
    <p class="mt-1.5 text-xs sm:text-sm text-slate-600">
      {pref.name}（代表都市：{pref.capital_city}）の解体工事単価・住宅地地価・放置空き家率と、最新税制（住宅用地の軽減解除・相続登記義務化）を反映した試算データです。
    </p>
  </div>

  <!-- 主要KPI 4枚 -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
    <div class="card-surface rounded p-4 border-t-2 border-t-emerald-700">
      <div class="text-[11px] font-bold text-slate-500">{pref.name} 木造解体坪単価</div>
      <div class="mt-1 text-2xl font-extrabold text-slate-900 tabular-nums">
        {pref.wood_man_per_tsubo.toFixed(2)}<span class="text-xs ml-0.5 text-slate-500">万円/坪</span>
      </div>
      <div class="mt-1 flex flex-wrap items-center justify-between gap-1 text-[11px] tabular-nums">
        <span class={`font-semibold ${pref.diff_national_wood > 0 ? "text-rose-700" : pref.diff_national_wood < 0 ? "text-emerald-700" : "text-slate-500"}`}>
          全国差 {formatDiffMan(pref.diff_national_wood, "万")}
        </span>
        <span class="text-slate-400">30坪総額 {formatManYen(pref.std_30tsubo_demolition_yen)}</span>
      </div>
    </div>

    <div class="card-surface rounded p-4 border-t-2 border-t-rose-600">
      <div class="text-[11px] font-bold text-slate-500">{pref.name} 総空き家率</div>
      <div class="mt-1 text-2xl font-extrabold text-rose-700 tabular-nums">
        {pref.akiya_rate_pct.toFixed(1)}<span class="text-xs ml-0.5 text-slate-500">%（全国{pref.akiya_rank}位）</span>
      </div>
      <div class="mt-1 text-[11px] text-slate-500 tabular-nums">
        うち放置型空き家率 {pref.other_akiya_rate_pct.toFixed(1)}%
      </div>
    </div>

    <div class="card-surface rounded p-4 border-t-2 border-t-amber-500">
      <div class="text-[11px] font-bold text-slate-500">特例解除時の固定資産税（45坪）</div>
      <div class="mt-1 text-2xl font-extrabold text-slate-900 tabular-nums">
        {formatYen(pref.std_heavy_tax_annual_yen)}<span class="text-xs ml-0.5 text-slate-500">/年</span>
      </div>
      <div class="mt-1 text-[11px] text-rose-700 font-semibold tabular-nums">
        通常時 {formatYen(pref.std_normal_tax_annual_yen)}/年 から急増
      </div>
    </div>

    <div class="card-surface rounded p-4 border-t-2 border-t-slate-600">
      <div class="text-[11px] font-bold text-slate-500">葬祭費給付金・公営火葬料</div>
      <div class="mt-1 text-2xl font-extrabold text-emerald-800 tabular-nums whitespace-nowrap">
        {formatYen(pref.funeral_grant_yen)}
      </div>
      <div class="mt-1 text-[11px] text-slate-500 tabular-nums">
        {pref.capital_city}火葬料：{pref.cremation_fee_yen === 0 ? "0円（無料）" : formatYen(pref.cremation_fee_yen)}
      </div>
    </div>
  </div>

  <!-- 推移グラフ -->
  <div class="mb-8">
    <CostTrendChart
      series={detail.series}
      title={`${pref.name} 構造別解体工事坪単価の推移（2024年〜${pref.latest_date}）`}
      subtitle={`木造 ${pref.wood_man_per_tsubo.toFixed(2)}万円/坪 ／ 鉄骨造 ${pref.steel_man_per_tsubo.toFixed(2)}万円/坪 ／ RC造 ${pref.rc_man_per_tsubo.toFixed(2)}万円/坪`}
    />
  </div>

  <!-- 県内代表4ケースの試算比較 -->
  <section class="card-surface rounded p-5 mb-8">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <div>
        <h2 class="text-base font-extrabold text-slate-900">{pref.name}での代表タイプ別 解体処分費・維持費・売却手残り目安</h2>
        <p class="text-xs text-slate-500 mt-0.5">
          県内の標準住宅地地価（約{pref.land_price_man_per_tsubo.toFixed(1)}万円/坪）と解体単価を適用した試算値です。
        </p>
      </div>
      <a
        href={`/tools/disposal-simulator/?pref=${pref.slug}`}
        class="rounded-xs bg-emerald-700 hover:bg-emerald-800 text-white px-3.5 py-2 text-xs font-bold transition-colors"
      >
        {pref.name}の条件で詳しく試算 →
      </a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-xs border-collapse tabular-nums">
        <thead>
          <tr class="border-b border-slate-200 text-slate-500 text-left">
            <th class="py-2 font-bold">代表ケース</th>
            <th class="py-2 font-bold">区分</th>
            <th class="py-2 font-bold text-right">解体 / 墓じまい総額</th>
            <th class="py-2 font-bold text-right">放置時の年間負担</th>
            <th class="py-2 font-bold text-right">最適処分時の手残り目安</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {
            pref.sample_cases.map((sc: any) => {
              const isGrave = sc.structure === "grave";
              return (
                <tr>
                  <td class="py-2.5 font-extrabold text-slate-900">
                    <a href={`/cases/${sc.slug}/`} class="hover:text-emerald-700 hover:underline">
                      {sc.short_name}
                    </a>
                  </td>
                  <td class="py-2.5 text-slate-600">{structureLabel(sc.structure)}</td>
                  <td class="py-2.5 text-right font-bold">
                    {formatYen(isGrave ? sc.hakajimai_initial_yen : sc.demolition_total_yen)}
                  </td>
                  <td class="py-2.5 text-right text-rose-700">
                    ▲{formatYen(sc.annual_keep_normal_yen)}/年
                  </td>
                  <td class="py-2.5 text-right font-extrabold text-emerald-800">
                    {isGrave ? "永代供養で以降0円" : `${formatSignedYen(sc.best_sale_net_yen)}（${sc.best_strategy_label}）`}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- 地域固有の解体赤字境界診断 ＆ 補助金・手続き確認ガイド -->
  <section class="grid gap-4 lg:grid-cols-2 mb-8">
    <div class="card-surface rounded p-5 border-l-3 border-l-emerald-700 space-y-2.5">
      <div class="text-[11px] font-bold text-emerald-700">{pref.name}の損益分岐ポイント</div>
      <h2 class="text-base font-extrabold text-slate-900">
        {pref.name}で「先に解体すると赤字（費用倒れ）」になりやすい境界線
      </h2>
      <p class="text-xs text-slate-600 leading-relaxed">
        {pref.name}で延床30坪の木造実家を解体すると<strong>約{demo30Man}万円</strong>が先にかかります。敷地45坪を基準にすると、県内の標準地価（坪約{pref.land_price_man_per_tsubo.toFixed(1)}万円）では土地評価が約{stdLand45Man.toLocaleString("ja-JP")}万円となる一方、
        <strong>郊外・郡部などで実勢地価が坪{breakevenLandPerTsuboMan}万円を下回るエリアでは、解体費と諸経費が売却額を上回るリスク</strong>が高まります。
      </p>
      <p class="text-xs text-slate-700 leading-relaxed bg-slate-50 border border-slate-200 rounded-xs p-3">
        {isLowLandPricePref
          ? `${pref.name}は全国平均と比べて住宅地地価が低めのエリアが多いため、自己資金で解体して更地にする前に「古家付き仲介」または「解体・片付け不要の専門買取」の手残りを比較しておくのが安全です。`
          : `${pref.name}でも${pref.capital_city}などの市街地と郊外・山間部では地価が大きく異なります。売れる見込みが立つ前に解体すると翌年から土地の固定資産税が上がるため、まずは壊さずに査定を取るのが安全です。`}
      </p>
    </div>

    <div class="card-surface rounded p-5 border-l-3 border-l-amber-600 space-y-2.5">
      <div class="text-[11px] font-bold text-amber-800">{pref.name}の公的支援・手続き確認</div>
      <h2 class="text-base font-extrabold text-slate-900">
        {pref.name}（{pref.capital_city}ほか各市区町村）で実家処分前に確認すべき3点
      </h2>
      <ul class="space-y-2 text-xs text-slate-700 leading-relaxed list-disc pl-4">
        <li>
          <strong>老朽空き家解体補助金（着工前申請が必須）：</strong>{pref.name}内の多くの市区町村では、老朽危険空き家の除却に対し30万〜100万円上限の補助制度を設けています。<strong>解体業者と契約・着工した後は対象外</strong>になるため、必ず事前相談してください。
        </li>
        <li>
          <strong>被相続人居住用家屋等確認書（3,000万円控除用）：</strong>空き家3,000万円特別控除を確定申告で使う際は、実家のある{pref.name}内の市区町村役場（住宅課・空き家対策課等）で確認書の発行が必要です。
        </li>
        <li>
          <strong>相続登記と売却期限の確認：</strong>名義が親のままでは売却も解体補助申請もできません。
          <a href="/tools/inheritance-deadline/" class="font-bold text-emerald-700 hover:underline">相続期限＆3,000万円控除カレンダー</a>で締切日を先に確認しておくと安心です。
        </li>
      </ul>
      <div class="pt-2 border-t border-slate-100">
        <div class="text-xs font-extrabold text-slate-900 mb-1">
          {pref.region}エリアの特徴：{regionNote.title}
        </div>
        <p class="text-xs text-slate-600 leading-relaxed mb-2">{regionNote.body}</p>
        <div class="flex flex-wrap gap-1.5">
          {regionNote.cases.map((rc) => (
            <a
              href={`/cases/${rc.slug}/`}
              class="rounded-xs border border-slate-200 bg-slate-50 hover:border-emerald-600 hover:bg-emerald-50/40 px-2.5 py-1 text-[11px] font-bold text-slate-700 hover:text-emerald-800 transition-colors"
            >
              {rc.label}の相場 →
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- よくある質問（都道府県固有数値Q&A） -->
  <section class="card-surface rounded p-5 mb-8">
    <h2 class="text-base font-extrabold text-slate-900 mb-3">{pref.name}の空き家・実家処分に関するよくある質問</h2>
    <div class="divide-y divide-slate-100 space-y-3">
      {prefFaqItems.map((faq, idx) => (
        <div class={idx > 0 ? "pt-3" : ""}>
          <h3 class="text-xs sm:text-sm font-extrabold text-slate-900">Q. {faq.q}</h3>
          <p class="mt-1 text-xs text-slate-600 leading-relaxed">A. {faq.a}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 年別平均アーカイブ -->
  <section class="card-surface rounded p-5 mb-8">
    <h2 class="text-base font-extrabold text-slate-900 mb-3">{pref.name} 年別平均解体単価・修繕指数アーカイブ</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-xs border-collapse tabular-nums">
        <thead>
          <tr class="border-b border-slate-200 text-slate-500 text-left">
            <th class="py-2 font-bold">年</th>
            <th class="py-2 font-bold text-right">木造解体平均</th>
            <th class="py-2 font-bold text-right">鉄骨造解体平均</th>
            <th class="py-2 font-bold text-right">RC造解体平均</th>
            <th class="py-2 font-bold text-right">維持修繕単価指数</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {
            detail.yearly_stats.map((y: any) => (
              <tr>
                <td class="py-2 font-bold text-slate-800">{y.year}年</td>
                <td class="py-2 text-right font-bold text-emerald-700">{y.avg_wood.toFixed(2)}万円/坪</td>
                <td class="py-2 text-right">{y.avg_steel.toFixed(2)}万円/坪</td>
                <td class="py-2 text-right">{y.avg_rc.toFixed(2)}万円/坪</td>
                <td class="py-2 text-right text-slate-600">{y.avg_repair_index.toFixed(1)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <AffiliateCta
    slotType="sell"
    title={`${pref.name}の実家は解体する前に「現状のままの売却・買取目安」を確認する`}
    description={`${pref.name}で30坪の木造実家を解体すると約${formatManYen(pref.std_30tsubo_demolition_yen)}が先行発生します。同じ県内でも立地や接道条件で売却額は数百万円変わるため、解体を発注する前に現状のままの目安と手続きを確認しておくのが安全です。`}
    fallbackHref={`/tools/disposal-simulator/?pref=${pref.slug}`}
    fallbackLabel={`${pref.name}の単価で10年損益を試算 →`}
  />
</BaseLayout>
