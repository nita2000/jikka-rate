---
import BaseLayout from "../layouts/BaseLayout.astro";
import CostTrendChart from "../components/CostTrendChart.astro";
import AffiliateCta from "../components/AffiliateCta.astro";
import siteMeta from "../data/meta.json";
import latest from "../data/latest.json";
import prefectures from "../data/prefectures.json";
import propertyCases from "../data/property_cases.json";
import comparePairs from "../data/compare_pairs.json";
import { formatManYen } from "../lib/formatters";

const featuredCaseSlugs = [
  "wood-30tsubo-age40",
  "kominka-farm-55tsubo-age60",
  "non-rebuildable-wood-25tsubo",
  "heavy-residual-hoarder-32tsubo",
  "rc-35tsubo-age40",
  "temple-grave-2sqm-far",
];
const featuredCases = featuredCaseSlugs
  .map((s) => propertyCases.find((c) => c.slug === s))
  .filter((c): c is (typeof propertyCases)[number] => Boolean(c));

const featuredPairSlugs = [
  "sarachi-sale-vs-furuya-kaitori-30tsubo",
  "akiya-keep-5y-vs-immediate-sale-30tsubo",
  "non-rebuildable-kaitori-vs-sarachi-trap",
  "akiya-normal-tax-vs-6x-heavy-tax",
  "seller-demolition-vs-buyer-demolition-3000man",
  "temple-grave-keep-15y-vs-hakajimai-jumokusou",
];
const featuredPairs = featuredPairSlugs
  .map((s) => comparePairs.find((p) => p.slug === s))
  .filter((p): p is (typeof comparePairs)[number] => Boolean(p));

const tokyoPref = prefectures.find((p) => p.slug === "tokyo") ?? prefectures[0];

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "実家と空き家の試算表",
    url: (Astro.site ?? "https://jikka-shisan.com").toString(),
    description:
      "全国47都道府県の解体工事費用・土地相場・空き家の固定資産税・譲渡所得税（3,000万円特別控除）・相続登記期限・墓じまい費用を公的統計にもとづいて試算し、実家を壊して売るか・そのまま手放すかの損益分岐点がわかるサイト。",
  },
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: `全国47都道府県 実家解体相場・空き家維持費＆墓じまい損益データベース（${siteMeta.date_from}〜${siteMeta.date_to}）`,
    description:
      "総務省・国土交通省・厚生労働省の公的統計と2026年最新空き家税制・相続登記基準をもとに集計した解体工事単価および損益分岐データセット。",
    url: (Astro.site ?? "https://jikka-shisan.com").toString(),
    license: "https://jikka-shisan.com/about/",
    temporalCoverage: `${siteMeta.date_from}/${siteMeta.date_to}`,
    creator: { "@type": "Organization", name: "実家と空き家の試算表" },
  },
];
---

<BaseLayout
  title="実家の手放し方・空き家の固定資産税・解体費用・墓じまいの公的相場＆手残り試算"
  description={`実家を先に解体して売るか、壊さずそのまま売却・買取するか、遠方のお墓をどうするかを30秒で試算。全国47都道府県の解体相場（木造平均${latest.national.wood_man_per_tsubo.toFixed(2)}万円/坪）・3,000万円控除・空き家の固定資産税・相続登記に対応。`}
  canonicalPath="/"
  schema={pageSchema}
>
  <!-- エディトリアル・ヒーロー -->
  <section slot="hero" class="hero-editorial py-10 sm:py-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 min-w-0 space-y-4">
          <div class="flex flex-wrap items-center gap-2 text-[11px] font-bold text-emerald-700 tracking-wider">
            <span class="inline-block w-0.5 h-3.5 bg-emerald-700"></span>
            <span>実家とお墓の公的相場＆損益ガイド</span>
            <span class="text-slate-300">/</span>
            <span class="text-slate-500 font-medium">3,000万円控除・相続登記・2026年最新単価対応</span>
          </div>

          <h1 class="text-2xl sm:text-4xl lg:text-[36px] font-extrabold tracking-tight leading-[1.26] text-slate-900">
            親の実家と遠方のお墓、<br />
            <span class="text-emerald-700">「壊さず手放す・解体・維持」</span>の<br class="hidden sm:inline" />
            一番損をしない選び方が30秒でわかる。
          </h1>

          <p class="text-sm sm:text-[15px] text-slate-600 leading-relaxed max-w-xl">
            「先に解体しないと売れないの？」「空き家のまま置くと固定資産税はいくら上がる？」—— 全国47都道府県の公的データと最新税制（3,000万円特別控除・相続登記義務化）をもとに、<strong>手元に残る金額と維持費・税金</strong>を比較できます。
          </p>

          <div class="flex flex-wrap gap-3 pt-1">
            <a
              href="/tools/disposal-simulator/"
              class="inline-flex items-center gap-2 rounded-xs bg-emerald-700 hover:bg-emerald-800 text-white px-5 py-3 text-sm font-bold transition-colors shadow-2xs"
            >
              実家の手残り金額を30秒で試算する
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            <a
              href="/tools/akiya-tax/"
              class="inline-flex items-center gap-2 rounded-xs bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 px-4 py-3 text-sm font-bold transition-colors"
            >
              空き家の固定資産税・登記を試算
            </a>
          </div>
        </div>

        <!-- ヒーロー右側：都道府県クイックボード -->
        <div class="lg:col-span-5 min-w-0">
          <div class="card-surface rounded border-t-3 border-t-emerald-700 p-5 sm:p-6">
            <div class="flex items-center justify-between gap-2 mb-2.5">
              <label for="hero-pref-select" class="text-[11px] font-bold tracking-wider text-emerald-700">
                実家・お墓のある都道府県を選択
              </label>
              <span class="text-[11px] text-slate-500 tabular-nums">基準日：{latest.date}</span>
            </div>
            <select
              id="hero-pref-select"
              class="w-full rounded-xs border border-slate-300 bg-white px-3.5 py-2.5 text-sm font-bold text-slate-900 focus:border-emerald-700 focus:outline-none"
            >
              {
                prefectures.map((p) => (
                  <option value={p.slug} selected={p.slug === "tokyo"}>
                    {p.name}（木造解体目安 {p.wood_man_per_tsubo.toFixed(1)}万円/坪）
                  </option>
                ))
              }
            </select>

            <div class="mt-4 grid grid-cols-3 gap-2.5 pt-4 border-t border-slate-100">
              <div>
                <div class="text-[11px] text-slate-500 whitespace-nowrap">30坪の解体総額目安</div>
                <div class="mt-1 font-display tabular-nums whitespace-nowrap">
                  <span class="text-xs text-slate-500 mr-0.5">約</span>
                  <span id="hq-demo30" class="text-xl font-extrabold text-slate-900">{Math.round(tokyoPref.std_30tsubo_demolition_yen / 10000)}</span>
                  <span class="text-[11px] text-slate-500 ml-0.5">万円</span>
                </div>
              </div>
              <div>
                <div class="text-[11px] text-slate-500 whitespace-nowrap">木造解体坪単価</div>
                <div class="mt-1 font-display tabular-nums whitespace-nowrap">
                  <span id="hq-wood" class="text-xl font-extrabold text-emerald-700">{tokyoPref.wood_man_per_tsubo.toFixed(2)}</span>
                  <span class="text-[11px] text-slate-500 ml-0.5">万円</span>
                </div>
              </div>
              <div>
                <div class="text-[11px] text-slate-500 whitespace-nowrap">県内 総空き家率</div>
                <div class="mt-1 font-display tabular-nums whitespace-nowrap">
                  <span id="hq-akiya" class="text-xl font-extrabold text-slate-800">{tokyoPref.akiya_rate_pct.toFixed(1)}</span>
                  <span class="text-[11px] text-slate-500 ml-0.5">%</span>
                </div>
              </div>
            </div>

            <div class="mt-3 pt-3 border-t border-slate-100 text-xs text-slate-600 flex items-center justify-between gap-2">
              <span class="whitespace-nowrap">軽減（1/6）解除時の固定資産税目安</span>
              <strong id="hq-heavy-tax" class="text-rose-700 tabular-nums whitespace-nowrap">年 約{Math.round(tokyoPref.std_heavy_tax_annual_yen / 10000)}万円</strong>
            </div>

            <div class="mt-3.5 pt-3 border-t border-slate-100 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-2.5">
              <a
                id="hq-sim-link"
                href="/tools/disposal-simulator/?pref=tokyo"
                class="inline-flex items-center justify-center rounded-xs bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2 text-xs font-bold transition-colors"
              >
                この県の実家で手残り金額を試算 →
              </a>
              <a id="hq-link" href="/pref/tokyo/" class="text-center text-xs font-bold text-emerald-700 hover:underline py-1 whitespace-nowrap">
                県別相場を見る →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4つのお悩み別シミュレーター導線 -->
  <section class="mb-10">
    <div class="mb-5">
      <div class="eyebrow-label">試算ツール</div>
      <h2 class="mt-0.5 text-xl sm:text-2xl font-extrabold text-slate-900">目的別の試算シミュレーター</h2>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <a href="/tools/disposal-simulator/" class="card-interactive rounded p-5 border-t-3 border-t-emerald-700 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between text-[11px] font-bold text-emerald-700">
            <span class="inline-flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 10.5L12 3l9 7.5V20a1 1 0 01-1 1h-5.5v-5.5h-5V21H4a1 1 0 01-1-1v-9.5z" />
              </svg>
              実家の手放し方
            </span>
            <span class="px-1.5 py-0.5 rounded-xs bg-emerald-50 text-emerald-800">手残り比較</span>
          </div>
          <h3 class="mt-2.5 text-sm sm:text-[15px] font-extrabold text-slate-900 leading-snug">
            壊して売る・そのまま売却買取・空き家維持の手残り試算
          </h3>
          <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
            解体費・譲渡税（3,000万円控除）・きょうだい分配まで一括比較。結果のLINE共有・印刷にも対応。
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-emerald-700">
          手残り金額を試算する →
        </div>
      </a>

      <a href="/tools/akiya-tax/" class="card-interactive rounded p-5 border-t-3 border-t-amber-600 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between text-[11px] font-bold text-amber-800">
            <span class="inline-flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              空き家の税金
            </span>
            <span class="px-1.5 py-0.5 rounded-xs bg-amber-50 text-amber-900">固定資産税</span>
          </div>
          <h3 class="mt-2.5 text-sm sm:text-[15px] font-extrabold text-slate-900 leading-snug">
            空き家の固定資産税（軽減解除）＆相続登記の費用試算
          </h3>
          <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
            住宅用地の1/6軽減が外れたときの増税額と、相続登記の登録免許税・過料を防ぐ手順を算出します。
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-amber-800">
          税金と対策を確認する →
        </div>
      </a>

      <a href="/tools/inheritance-deadline/" class="card-interactive rounded p-5 border-t-3 border-t-rose-600 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between text-[11px] font-bold text-rose-700">
            <span class="inline-flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              期限・控除判定
            </span>
            <span class="px-1.5 py-0.5 rounded-xs bg-rose-50 text-rose-800">締切逆算</span>
          </div>
          <h3 class="mt-2.5 text-sm sm:text-[15px] font-extrabold text-slate-900 leading-snug">
            相続手続き期限＆空き家3,000万円特別控除 逆算カレンダー
          </h3>
          <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
            相続開始日から相続放棄・相続登記・3,000万円控除の売却締切日を自動計算。6問の控除判定付き。
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-rose-700">
          締切日と要件を確認する →
        </div>
      </a>

      <a href="/tools/hakajimai-simulator/" class="card-interactive rounded p-5 border-t-3 border-t-slate-700 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between text-[11px] font-bold text-slate-700">
            <span class="inline-flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              遠方のお墓
            </span>
            <span class="px-1.5 py-0.5 rounded-xs bg-slate-100 text-slate-700">回収年数</span>
          </div>
          <h3 class="mt-2.5 text-sm sm:text-[15px] font-extrabold text-slate-900 leading-snug">
            遠方のお墓維持 vs 墓じまい・樹木葬 15年損益試算
          </h3>
          <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">
            毎年の帰省費・管理料と、墓石撤去＋永代供養への改葬費用を比べ、何年で元が取れるか試算します。
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-slate-100 text-xs font-bold text-slate-700">
          墓じまい費用を試算する →
        </div>
      </a>
    </div>

    <!-- 築古・訳あり実家の4大お悩みショートカット -->
    <div class="mt-5 card-surface rounded p-4 sm:p-5 bg-slate-50/60">
      <div class="text-xs font-extrabold text-slate-800 mb-3">「うちの実家は売れるの？」よくある4つのケースからすぐ調べる</div>
      <div class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-4 text-xs">
        <a href="/compare/sarachi-sale-vs-furuya-kaitori-30tsubo/" class="rounded-xs border border-slate-200 bg-white hover:border-emerald-700 px-3 py-2.5 transition-colors block">
          <div class="font-extrabold text-slate-900">解体すると赤字になりそう</div>
          <div class="text-[11px] text-slate-500 mt-0.5">更地解体 vs 壊さず買取の損益分岐 →</div>
        </a>
        <a href="/compare/non-rebuildable-kaitori-vs-sarachi-trap/" class="rounded-xs border border-slate-200 bg-white hover:border-emerald-700 px-3 py-2.5 transition-colors block">
          <div class="font-extrabold text-slate-900">道が狭い・建て替え不可（再建築不可）</div>
          <div class="text-[11px] text-slate-500 mt-0.5">解体厳禁の理由と買取手残り比較 →</div>
        </a>
        <a href="/compare/heavy-residual-clean-vs-as-is-kaitori/" class="rounded-xs border border-slate-200 bg-white hover:border-emerald-700 px-3 py-2.5 transition-colors block">
          <div class="font-extrabold text-slate-900">家具・荷物がそのまま残っている</div>
          <div class="text-[11px] text-slate-500 mt-0.5">自費片付け vs 現状そのまま買取 →</div>
        </a>
        <a href="/compare/kominka-55tsubo-sarachi-vs-kaitori/" class="rounded-xs border border-slate-200 bg-white hover:border-emerald-700 px-3 py-2.5 transition-colors block">
          <div class="font-extrabold text-slate-900">地方の広い実家・母屋＋納屋</div>
          <div class="text-[11px] text-slate-500 mt-0.5">300万円超の解体費用倒れ回避策 →</div>
        </a>
      </div>
    </div>
  </section>

  <!-- 実家・お墓のタイプ別相場データベース -->
  <section class="mb-12">
    <div class="flex flex-wrap items-end justify-between gap-2 mb-5">
      <div>
        <div class="eyebrow-label">うちの条件に近い実家・お墓から探す</div>
        <h2 class="mt-0.5 text-xl sm:text-2xl font-extrabold text-slate-900">実家・空き家・お墓のタイプ別 解体費用＆維持費の目安</h2>
      </div>
      <div class="flex items-center gap-4 text-[11px]">
        <span class="hidden sm:inline-flex items-center gap-1 text-slate-500"><span class="h-2 w-2 rounded-xs bg-emerald-700"></span>本体工事</span>
        <span class="hidden sm:inline-flex items-center gap-1 text-slate-500"><span class="h-2 w-2 rounded-xs bg-amber-500"></span>片付け・外構</span>
        <span class="hidden sm:inline-flex items-center gap-1 text-slate-500"><span class="h-2 w-2 rounded-xs bg-slate-400"></span>調査・諸費用</span>
        <a href="/cases/" class="text-xs font-bold text-emerald-700 hover:underline">タイプ別の一覧を見る →</a>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        featuredCases.map((c) => {
          const isGrave = c.structure === "grave";
          const demo = c.calc.demolition;
          const haka = c.calc.hakajimai;
          const totalCost = isGrave && haka ? haka.initial_total_yen : Math.max(1, demo.total_demolition_yen);
          const keepCost = isGrave && haka ? haka.keep_total_15y_yen : c.calc.maintenance.keep_10y_heavy;
          const pctBody = isGrave && haka
            ? Math.round((haka.stone_removal_yen / totalCost) * 100)
            : Math.round((demo.building_body_yen / totalCost) * 100);
          const pctSub = isGrave && haka
            ? Math.round((haka.ceremony_and_ridan_yen / totalCost) * 100)
            : Math.round(((demo.residual_items_yen + demo.exterior_fence_yen) / totalCost) * 100);
          const pctExtra = Math.max(0, 100 - pctBody - pctSub);
          return (
            <a href={`/cases/${c.slug}/`} class="card-interactive rounded p-4 sm:p-5 block">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[11px] font-bold text-emerald-700">{c.category_label}</span>
                <span class="text-[11px] text-slate-400 tabular-nums">{isGrave ? `墓地 ${c.grave_sqm}㎡` : `延床${c.floor_tsubo}坪 / 敷地${c.land_tsubo}坪`}</span>
              </div>
              <h3 class="mt-1 text-base font-extrabold text-slate-900">{c.short_name}</h3>

              <!-- 3色ミニ構成比バー -->
              <div class="mt-3 flex h-1.5 w-full overflow-hidden rounded-xs bg-slate-100">
                <div class="bg-emerald-700" style={`width:${pctBody}%`}></div>
                <div class="bg-amber-500" style={`width:${pctSub}%`}></div>
                <div class="bg-slate-400" style={`width:${pctExtra}%`}></div>
              </div>

              <div class="mt-3 grid grid-cols-2 gap-2.5 rounded-xs bg-slate-50 p-3 text-xs">
                <div>
                  <div class="text-[10px] text-slate-500">{isGrave ? "墓じまい＋樹木葬目安" : "解体・片付け総額目安"}</div>
                  <div class="mt-0.5 font-extrabold text-slate-900 tabular-nums">約 {formatManYen(totalCost)}</div>
                </div>
                <div>
                  <div class="text-[10px] text-slate-500">{isGrave ? "15年間の維持費累計" : "10年間の維持費・税累計"}</div>
                  <div class="mt-0.5 font-extrabold text-rose-700 tabular-nums">
                    約 {formatManYen(keepCost)}
                  </div>
                </div>
              </div>
              <div class="mt-3 flex items-center justify-between text-[11px] text-slate-500">
