  <script is:inline define:vars={{ prefsData: prefectures }}>
    const byPref = Object.fromEntries(prefsData.map((p) => [p.slug, p]));
    const sel = document.getElementById("hero-pref-select");
    const elWood = document.getElementById("hq-wood");
    const elAkiya = document.getElementById("hq-akiya");
    const elDemo30 = document.getElementById("hq-demo30");
    const elHeavyTax = document.getElementById("hq-heavy-tax");
    const elLink = document.getElementById("hq-link");
    const elSimLink = document.getElementById("hq-sim-link");

    if (sel) {
      sel.addEventListener("change", () => {
        const p = byPref[sel.value];
        if (!p) return;
        elWood.textContent = p.wood_man_per_tsubo.toFixed(2);
        elAkiya.textContent = p.akiya_rate_pct.toFixed(1);
        elDemo30.textContent = String(Math.round(p.std_30tsubo_demolition_yen / 10000));
        elHeavyTax.textContent = `年 約${Math.round(p.std_heavy_tax_annual_yen / 10000).toLocaleString("ja-JP")}万円`;
        elLink.setAttribute("href", `/pref/${p.slug}/`);
        if (elSimLink) {
          elSimLink.setAttribute("href", `/tools/disposal-simulator/?pref=${p.slug}`);
        }
      });
